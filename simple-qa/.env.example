# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# API Keys for Search Tools
# Valyu API key (required for --tool valyu)
VALYU_API_KEY=your_valyu_api_key_here

# Exa API key (required for --tool exa)
EXA_API_KEY=your_exa_api_key_here

# SerpAPI key for Google Search (required for --tool google)
SERPAPI_KEY=your_serpapi_key_here

# Parallel AI API key (required for --tool parallel)
PARALLEL_API_KEY=your_parallel_api_key_here

# OpenAI API Key (required for grading model in SimpleQA)
OPENAI_API_KEY=your_openai_api_key_here
