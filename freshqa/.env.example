# ============================================================================
# Search Tool API Keys
# ============================================================================
# Get your API keys from the respective providers

# Valyu API (required for valyu search tool)
VALYU_API_KEY=your_valyu_api_key_here

# SerpAPI (required for google search tool)
SERPAPI_KEY=your_serpapi_key_here

# Exa API (required for exa search tool)
EXA_API_KEY=your_exa_api_key_here

# Parallel AI API (required for parallel search tool)
PARALLEL_API_KEY=your_parallel_api_key_here

# ============================================================================
# Google Gemini API Configuration
# ============================================================================
# Required for Gemini AI model (used in query.ts for response generation)

# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Claude Evaluation Configuration
# ============================================================================
# Choose ONE of the following options:

# Option 1: Direct Anthropic API (default, omit --use-vertex or use --use-vertex false)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: Vertex AI (use with --use-vertex true)
# Your GCP project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCP region for Claude (default: us-east5)
GOOGLE_CLOUD_LOCATION=us-east5

# Path to your GCP service account key JSON file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
